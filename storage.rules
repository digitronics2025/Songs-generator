rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isOwner() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email.lower() in /* OWNER_EMAILS */ [];
    }

    match /songs/{path=**} {
      allow read: if isOwner();
      // Only the owner API writes through its service identity. Signed URLs
      // are authorized by Cloud Storage IAM rather than these Firebase rules.
      allow write: if false;
    }
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
