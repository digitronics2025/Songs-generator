{
  "name": "darija-song-studio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "start": "tsx server.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:emulators": "firebase emulators:exec --config firebase.emulator.json --project demo-darija-studio --only auth,firestore,storage \"vitest run --config vitest.emulator.config.ts\"",
    "rules:render": "tsx scripts/render-rules.ts"
  },
  "dependencies": {
    "@google/genai": "^3.6.1",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "ffmpeg-static": "^5.3.0",
    "firebase": "^13.4.0",
    "firebase-admin": "^14.5.1",
    "jszip": "^3.10.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tsx": "^4.21.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/express": "^5.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.15.0",
    "firebase-tools": "^15.37.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.3.0",
    "vitest": "^4.0.0"
  },
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "^1.14.7"
