{
  "entities": {
    "Song": {
      "title": "Song",
      "description": "An open-ended Moroccan Darija song entry with lyrics, admin_feeling, musical settings, lifecycle status, best take reference, and timestamps.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Permanent Firestore document ID for a default or user-created song."
        },
        "number": {
          "type": "integer",
          "description": "Monotonically increasing display number (1, 2, 3, ...), never reused."
        },
        "title": {
          "type": "string",
          "maxLength": 120,
          "description": "Short Arabic script title."
        },
        "lines": {
          "type": "array",
          "description": "Moroccan Darija lyric lines in Arabic script."
        },
        "admin_feeling": {
          "type": "string",
          "maxLength": 64,
          "description": "Category from feelings list (e.g. mothers_care, fathers_pride, etc.)."
        },
        "feeling_key": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-z0-9_]+$",
          "description": "Canonical snake_case feeling identifier used in filenames and songs.json."
        },
        "theme": {
          "type": "string",
          "maxLength": 240,
          "description": "Short English description of the human feeling."
        },
        "mood": {
          "type": "string",
          "maxLength": 80,
          "description": "Emotional mood descriptor."
        },
        "tempo_bpm": {
          "type": "number",
          "description": "Tempo in beats per minute (70 to 100)."
        },
        "instruments": {
          "type": "string",
          "maxLength": 300,
          "description": "Moroccan acoustic instrumentation description."
        },
        "vocal_tone": {
          "type": "string",
          "maxLength": 300,
          "description": "Lead vocal character instruction."
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "lyric_approved",
            "generating",
            "ready",
            "approved",
            "failed",
            "needs_person",
            "archived"
          ],
          "description": "Current song lifecycle status."
        },
        "best_take_id": {
          "type": "string",
          "maxLength": 128,
          "description": "ID of the chosen take (e.g. take_1)."
        },
        "created_at": {
          "type": "string",
          "maxLength": 64,
          "description": "ISO-8601 creation timestamp."
        },
        "updated_at": {
          "type": "string",
          "maxLength": 64,
          "description": "ISO-8601 update timestamp."
        },
        "archived": {
          "type": "boolean",
          "description": "Whether this song is archived from library views."
        },
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "description": "Firebase Auth UID of the creator/owner."
        },
        "file_name": {
          "type": "string",
          "description": "Original export filename, retained across migrations and takes."
        }
      },
      "required": [
        "id",
        "number",
        "title",
        "lines",
        "admin_feeling",
        "feeling_key",
        "theme",
        "mood",
        "tempo_bpm",
        "instruments",
        "vocal_tone",
        "status",
        "created_at",
        "updated_at",
        "archived",
        "ownerId"
      ]
    },
    "Take": {
      "title": "Take",
      "description": "An audio generation take for a song, storing model, storage path, loudness, and quality metrics.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Take unique ID."
        },
        "take_number": {
          "type": "integer",
          "description": "1-based take index for this song."
        },
        "model": {
          "type": "string",
          "maxLength": 64,
          "description": "Lyria model ID used."
        },
        "storage_path": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256,
          "description": "Cloud Storage object path."
        },
        "download_url": {
          "type": "string",
          "maxLength": 1024,
          "description": "Cloud Storage download URL."
        },
        "duration_seconds": {
          "type": [
            "number",
            "null"
          ],
          "description": "WAV duration in seconds."
        },
        "lufs": {
          "type": [
            "number",
            "null"
          ],
          "description": "Integrated loudness in LUFS (-14 target)."
        },
        "true_peak_db": {
          "type": [
            "number",
            "null"
          ],
          "description": "True peak in dBTP (<= -1.0 target)."
        },
        "words_heard_pct": {
          "type": "number",
          "description": "Percentage (0-100) of words heard in transcription."
        },
        "missing_words": {
          "type": "array",
          "description": "Missing lyric words."
        },
        "extra_words": {
          "type": "array",
          "description": "Extra transcribed words."
        },
        "voice_start": {
          "type": "number",
          "description": "Singing voice start timestamp in seconds."
        },
        "voice_end": {
          "type": "number",
          "description": "Singing voice end timestamp in seconds."
        },
        "cost_estimate": {
          "type": "number",
          "description": "Estimated cost in USD for this take."
        },
        "created_at": {
          "type": "string",
          "maxLength": 64,
          "description": "ISO-8601 creation timestamp."
        },
        "status": {
          "type": "string",
          "enum": [
            "generating",
            "ready",
            "failed"
          ],
          "description": "Take status."
        },
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "description": "Firebase Auth UID."
        },
        "lyric_revision": {
          "type": "string",
          "description": "SHA-256 of the title and exact lyric lines at generation."
        },
        "raw_storage_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "is_approved": {
          "type": "boolean"
        },
        "passed_all_checks": {
          "type": "boolean"
        },
        "failure_reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "repeated_words": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "failure_detail": {
          "type": [
            "object",
            "null"
          ],
          "description": "The stage and redacted diagnostic for the latest processing or quality failure.",
          "properties": {
            "stage": {
              "type": "string"
            },
            "message": {
              "type": "string",
              "maxLength": 180
            }
          }
        },
        "vocal_check_pending": {
          "type": "boolean",
          "description": "A mastered WAV is available but its vocals still need analysis before approval."
        }
      },
      "required": [
        "id",
        "take_number",
        "model",
        "storage_path",
        "duration_seconds",
        "lufs",
        "true_peak_db",
        "cost_estimate",
        "created_at",
        "status",
        "ownerId"
      ]
    },
    "SongHistory": {
      "title": "SongHistory",
      "description": "Immutable log of every lyric created, edited, approved, or archived.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "History entry ID."
        },
        "song_id": {
          "type": "string",
          "maxLength": 128,
          "description": "Parent song ID."
        },
        "song_number": {
          "type": "integer",
          "description": "Parent song display number."
        },
        "title": {
          "type": "string",
          "maxLength": 120,
          "description": "Arabic title at this version."
        },
        "lines": {
          "type": "array",
          "description": "Lyrics array at this version."
        },
        "admin_feeling": {
          "type": "string",
          "maxLength": 64,
          "description": "Admin feeling category."
        },
        "action": {
          "type": "string",
          "enum": [
            "created",
            "edited",
            "archived",
            "restored",
            "migrated",
            "lyric_approved",
            "imported",
            "imported"
          ],
          "description": "Action performed."
        },
        "timestamp": {
          "type": "string",
          "maxLength": 64,
          "description": "ISO-8601 timestamp."
        },
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "description": "Firebase Auth UID."
        }
      },
      "required": [
        "id",
        "song_id",
        "song_number",
        "title",
        "lines",
        "admin_feeling",
        "action",
        "timestamp",
        "ownerId"
      ]
    },
    "Settings": {
      "title": "Settings",
      "description": "Studio-wide song creation, lyric checking, and model parameters.",
      "type": "object",
      "properties": {
        "feelings": {
          "type": "array",
          "description": "Allowed feelings list."
        },
        "lines_per_song": {
          "type": "integer",
          "description": "Target lines per song (default 6)."
        },
        "max_words_per_line": {
          "type": "integer",
          "description": "Maximum allowed words per line (default 5)."
        },
        "forbidden_words": {
          "type": "array",
          "description": "Forbidden words list."
        },
        "block_substrings": {
          "type": "boolean",
          "description": "Whether to also block words containing forbidden words as substrings."
        },
        "no_numbers_prices_brands": {
          "type": "boolean",
          "description": "Whether to forbid numbers, prices, and brand names."
        },
        "default_model": {
          "type": "string",
          "maxLength": 64,
          "description": "Default Lyria model (lyria-3-clip-preview or lyria-3.5)."
        },
        "target_length": {
          "type": "number",
          "description": "Target track duration in seconds (default 30)."
        },
        "updated_at": {
          "type": "string",
          "maxLength": 64,
          "description": "ISO-8601 timestamp of last settings update."
        },
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "description": "Firebase Auth UID."
        },
        "daily_budget_usd": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000,
          "description": "Maximum estimated Gemini spend per UTC day."
        }
      },
      "required": [
        "feelings",
        "lines_per_song",
        "max_words_per_line",
        "forbidden_words",
        "block_substrings",
        "no_numbers_prices_brands",
        "default_model",
        "target_length",
        "updated_at",
        "ownerId"
      ]
    }
  },
  "firestore": {
    "/songs/{songId}": {
      "schema": {
        "$ref": "#/entities/Song"
      },
      "description": "Open-ended Moroccan Darija songs library, keyed by permanent song ID."
    },
    "/songs/{songId}/takes/{takeId}": {
      "schema": {
        "$ref": "#/entities/Take"
      },
      "description": "Generated audio takes for each song."
    },
    "/song_history/{historyId}": {
      "schema": {
        "$ref": "#/entities/SongHistory"
      },
      "description": "Immutable history of every lyric created, edited, approved, or archived."
    },
    "/settings/{settingId}": {
      "schema": {
        "$ref": "#/entities/Settings"
      },
      "description": "Studio configuration settings including feelings, lyric rules, and default model."
    }
  }
}
