# Set these in AI Studio or Cloud Run. Keep all values private.
GEMINI_API_KEY=
OWNER_EMAILS=
# Set to 1 only when the runtime can read Firebase Auth users for revocation checks.
AUTH_CHECK_REVOKED=0
# USD per UTC day. Costs are reserved before each call. 0 disables paid calls.
# Settings & Rules can override this fallback.
STUDIO_DAILY_BUDGET_USD=0
# Optional absolute path to a maintained FFmpeg binary, tried before the bundled binary, ffmpeg-static, and PATH.
FFMPEG_PATH=
PORT=3000

# Exact Cloud Scheduler service account email and the OIDC audience for /api/autopilot/run.
AUTOPILOT_INVOKER_SA=
AUTOPILOT_AUDIENCE=
# Optional Messenger notification endpoint, scoped token and recipient email.
AUTOPILOT_REPORT_URL=
AUTOPILOT_REPORT_TOKEN=
AUTOPILOT_REPORT_RECIPIENT=
