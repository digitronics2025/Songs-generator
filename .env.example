# Set these in AI Studio or Cloud Run. Keep all values private.
GEMINI_API_KEY=
OWNER_EMAILS=
# Set to 1 only when the runtime can read Firebase Auth users for revocation checks.
AUTH_CHECK_REVOKED=0
# USD per UTC day. Costs are reserved before each call. 0 disables paid calls.
# Settings & Rules can override this fallback.
STUDIO_DAILY_BUDGET_USD=0
# Optional absolute path to a maintained FFmpeg binary.
FFMPEG_PATH=
PORT=3000
