rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email.lower() in /* OWNER_EMAILS */ [];
    }

    match /songs/{songId} {
      allow read: if isOwner();
      match /takes/{takeId} {
        allow read: if isOwner();
      }
      match /repair_logs/{logId} {
        allow read: if isOwner();
      }
      match /acknowledgements/{ackId} {
        allow read: if isOwner();
      }
    }
    match /song_history/{historyId} {
      allow read: if isOwner();
    }
    match /settings/app_settings {
      allow read: if isOwner();
    }

    // All writes go through the owner or scoped partner API. No client deletes.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
