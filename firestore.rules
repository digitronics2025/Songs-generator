rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isStudioAdmin() {
      return isVerified() && request.auth.token.email == 'contact@tenten.ma';
    }

    function isValidNullableString(val, maxLen) {
      return val == null || (val is string && val.size() <= maxLen);
    }

    function isValidNullableNumber(val) {
      return val == null || val is number;
    }

    function isValidBoundedWordList(arr, maxItems) {
      return arr is list
        && arr.size() <= maxItems
        && (arr.size() == 0 || (arr[0] is string && arr[0].size() <= 120));
    }

    function isValidLines(lines) {
      return lines is list
        && lines.size() >= 1
        && lines.size() <= 8
        && lines[0] is string && lines[0].size() <= 240
        && (lines.size() < 2 || (lines[1] is string && lines[1].size() <= 240))
        && (lines.size() < 3 || (lines[2] is string && lines[2].size() <= 240))
        && (lines.size() < 4 || (lines[3] is string && lines[3].size() <= 240))
        && (lines.size() < 5 || (lines[4] is string && lines[4].size() <= 240))
        && (lines.size() < 6 || (lines[5] is string && lines[5].size() <= 240))
        && (lines.size() < 7 || (lines[6] is string && lines[6].size() <= 240))
        && (lines.size() < 8 || (lines[7] is string && lines[7].size() <= 240));
    }

    function isValidAdminFeeling(val) {
      return val is string
        && val.size() <= 32
        && val in [
          'mothers_care',
          'fathers_pride',
          'family_evening',
          'ramadan_ftour',
          'eid_morning',
          'calling_home',
          'summer_at_home',
          'new_home'
        ];
    }

    function isValidSong(data) {
      return data.keys().hasAll([
          'number', 'feeling_key', 'title', 'theme', 'lines', 'mood',
          'tempo_bpm', 'instruments', 'vocal_tone', 'model_used', 'status',
          'duration_seconds', 'lufs', 'true_peak_db', 'file_name',
          'storage_path', 'generated_at', 'error_message', 'ownerId'
        ])
        && data.keys().hasOnly([
          'number', 'feeling_key', 'admin_feeling', 'title', 'theme', 'lines', 'mood',
          'tempo_bpm', 'instruments', 'vocal_tone', 'model_used', 'status',
          'duration_seconds', 'lufs', 'true_peak_db', 'file_name',
          'storage_path', 'download_url', 'generated_at', 'error_message',
          'words_heard_pct', 'transcribed_text', 'missing_words', 'extra_words',
          'voice_start_seconds', 'voice_end_seconds', 'ownerId'
        ])
        && data.number is int && data.number >= 1 && data.number <= 20
        && data.feeling_key is string && data.feeling_key.size() >= 1 && data.feeling_key.size() <= 64 && data.feeling_key.matches('^[a-z0-9_]+$')
        && (!('admin_feeling' in data) || isValidAdminFeeling(data.admin_feeling))
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 120
        && data.theme is string && data.theme.size() >= 1 && data.theme.size() <= 240
        && isValidLines(data.lines)
        && data.mood is string && data.mood.size() >= 1 && data.mood.size() <= 80
        && data.tempo_bpm is number && data.tempo_bpm >= 70 && data.tempo_bpm <= 100
        && data.instruments is string && data.instruments.size() >= 1 && data.instruments.size() <= 300
        && data.vocal_tone is string && data.vocal_tone.size() >= 1 && data.vocal_tone.size() <= 300
        && isValidNullableString(data.model_used, 64)
        && data.status in ['pending', 'generating', 'ready', 'error']
        && isValidNullableNumber(data.duration_seconds)
        && isValidNullableNumber(data.lufs)
        && isValidNullableNumber(data.true_peak_db)
        && data.file_name is string && data.file_name.size() >= 1 && data.file_name.size() <= 100
        && isValidNullableString(data.storage_path, 200)
        && (!('download_url' in data) || isValidNullableString(data.download_url, 1000))
        && isValidNullableString(data.generated_at, 64)
        && isValidNullableString(data.error_message, 1000)
        && (!('words_heard_pct' in data) || data.words_heard_pct == null || (data.words_heard_pct is number && data.words_heard_pct >= 0 && data.words_heard_pct <= 100))
        && (!('transcribed_text' in data) || isValidNullableString(data.transcribed_text, 2000))
        && (!('missing_words' in data) || isValidBoundedWordList(data.missing_words, 50))
        && (!('extra_words' in data) || isValidBoundedWordList(data.extra_words, 50))
        && (!('voice_start_seconds' in data) || data.voice_start_seconds == null || (data.voice_start_seconds is number && data.voice_start_seconds >= 0 && data.voice_start_seconds <= 300))
        && (!('voice_end_seconds' in data) || data.voice_end_seconds == null || (data.voice_end_seconds is number && data.voice_end_seconds >= 0 && data.voice_end_seconds <= 300))
        && data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128;
    }

    match /songs/{songId} {
      allow get: if isVerified() && isValidId(songId) && (resource == null || existing().ownerId == request.auth.uid || isStudioAdmin());
      allow list: if isVerified() && (resource.data.ownerId == request.auth.uid || isStudioAdmin());
      allow create: if isVerified()
        && isValidId(songId)
        && isValidSong(incoming())
        && incoming().ownerId == request.auth.uid
        && string(incoming().number) == songId;
      allow update: if isVerified()
        && isValidId(songId)
        && isValidSong(incoming())
        && (existing().ownerId == request.auth.uid || isStudioAdmin())
        && incoming().ownerId == existing().ownerId
        && incoming().number == existing().number
        && incoming().feeling_key == existing().feeling_key
        && incoming().file_name == existing().file_name
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['title', 'theme', 'lines', 'mood', 'tempo_bpm', 'instruments', 'vocal_tone', 'admin_feeling'])
          || incoming().diff(existing()).affectedKeys().hasOnly(['status', 'model_used', 'duration_seconds', 'lufs', 'true_peak_db', 'storage_path', 'download_url', 'generated_at', 'error_message', 'words_heard_pct', 'transcribed_text', 'missing_words', 'extra_words', 'voice_start_seconds', 'voice_end_seconds'])
          || isStudioAdmin()
        );
      allow delete: if false;
    }
  }
}
